---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

interface Props {
	id?: string;
	/** An imported asset (preferred) or a `/public` path / remote URL. */
	src?: ImageMetadata | string;
	class?: string;
	alt?: string;
	position?: string;
	priority?: boolean;
}

const { id, src, alt = "", position = "center", priority = false } = Astro.props;
const className = Astro.props.class;

// Astro accepts imported image metadata as either a plain object or a callable
// value (`typeof src === "function" && "src" in src`, see astro's imageKind.js),
// so mirror that check instead of only accepting `typeof === "object"`.
function isImageMetadataLike(value: unknown): value is ImageMetadata {
	return (
		(typeof value === "object" && value !== null) ||
		(typeof value === "function" && "src" in value)
	);
}

const asset = isImageMetadataLike(src) ? src : undefined;
const plainSrc = typeof src === "string" && src.trim() !== "" ? src : undefined;

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {asset && <Image src={asset} alt={alt} class={imageClass} style={imageStyle} priority={priority}/>}
    {plainSrc && <img src={plainSrc.startsWith("/") ? url(plainSrc) : plainSrc} alt={alt} class={imageClass} style={imageStyle}
                      loading={priority ? "eager" : "lazy"} decoding="async" fetchpriority={priority ? "high" : "auto"}/>}
</div>
